APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted server credential for background publishing work (sb_secret_...).
# Server only. Never NEXT_PUBLIC, never logged, never committed.
SUPABASE_SECRET_KEY=

# Legacy form, superseded by SUPABASE_SECRET_KEY. Nothing reads it.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Encrypts stored OAuth tokens and resumable upload
# session URIs with AES-256-GCM. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored credential unreadable, and every connected
# account has to be reconnected. Server only.
TOKEN_ENCRYPTION_KEY=

AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Google OAuth 2.0, used for the YouTube connection.
# GOOGLE_REDIRECT_URI must be <APP_URL>/api/oauth/google/callback and must
# match the URI registered in Google Cloud Console character for character —
# a trailing slash is a different URI. See docs/stage-7-youtube.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
