APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted server credential for background publishing work (sb_secret_...).
# Server only. Never NEXT_PUBLIC, never logged, never committed.
SUPABASE_SECRET_KEY=

# Legacy form, superseded by SUPABASE_SECRET_KEY. Nothing reads it.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Encrypts stored OAuth tokens and resumable upload
# session URIs with AES-256-GCM. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored credential unreadable, and every connected
# account has to be reconnected. Server only.
TOKEN_ENCRYPTION_KEY=

AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Instagram, via a Meta Business app with Business Login for Instagram.
# META_REDIRECT_URI must be <APP_URL>/api/oauth/meta/callback and must match a
# redirect URI registered on the app exactly.
# Publishing needs the instagram_business_content_publish permission, which
# Meta grants only after App Review. See docs/stage-8-media-instagram.md.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# TikTok, via a TikTok for Developers app with Login Kit and Content Posting.
# TIKTOK_REDIRECT_URI must be <APP_URL>/api/oauth/tiktok/callback and must
# match a redirect URI registered on the app exactly.
# The variable is CLIENT_KEY, not CLIENT_ID: TikTok's own parameter name is
# `client_key`, and sending `client_id` is rejected for a reason the error
# message does not explain.
# Posting directly needs the video.publish scope AND TikTok's audit — an
# unaudited client can only post SELF_ONLY. See docs/stage-9-tiktok.md.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Google OAuth 2.0, used for the YouTube connection.
# GOOGLE_REDIRECT_URI must be <APP_URL>/api/oauth/google/callback and must
# match the URI registered in Google Cloud Console character for character —
# a trailing slash is a different URI. See docs/stage-7-youtube.md.
# YouTube *analytics* needs a scope publishing does not include —
# https://www.googleapis.com/auth/yt-analytics.readonly — which must be added
# to the OAuth consent screen before the re-consent on Connected Accounts can
# succeed. Publishing keeps working without it; analytics simply reports that
# the permission is missing. See docs/stage-10-analytics-growth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# The id of the approved "Precious Promises Content" folder — the only folder
# this application will read. Copy it from the folder's URL, after /folders/.
# Nothing outside it can be listed, imported or published.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
